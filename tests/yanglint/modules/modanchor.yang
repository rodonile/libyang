module modanchor {
  yang-version 1.1;
  namespace "urn:yanglint:modanchor";
  prefix ma;

  container message {
    leaf target {
      type string;
    }
    anydata value;
  }
  container x {
    leaf a {
      type uint8 {
        range "0";
      }
    }
  }
  leaf a {
    type uint8 {
      range "1";
    }
  }
}
