source [expr {[info exists ::env(TESTS_DIR)] ? "$env(TESTS_DIR)/interactive/ly.tcl" : "ly.tcl"}]

set ddir $::env(TESTS_DIR)/data

test data_anchor_basic {anchor is available to the interactive data command} {
-setup $ly_setup -cleanup $ly_cleanup -body {
    ly_cmd "load modanchor"
    ly_cmd_err "data -a /modanchor:x -e $ddir/modanchor.json" "requires --anydata-strict"
    ly_cmd "data -A --anchor=/modanchor:x/a -e $ddir/modanchor.json"
    ly_cmd "data -A -a /modanchor:x/a -e $ddir/modanchor.json"
    ly_cmd_err "data -A --anchor=/modanchor:a -e $ddir/modanchor.json" "Unsatisfied range"
}}

test data_anchor_reset {anchor does not persist between commands} {
-setup $ly_setup -cleanup $ly_cleanup -body {
    ly_cmd "load modanchor"
    ly_cmd_err "data -A --anchor=relative $ddir/modanchor.json" "must be an absolute schema path"
    ly_cmd "data -A --anchor=/modanchor:x/a -e $ddir/modanchor.json"
    ly_cmd "data -e $ddir/modanchor.json"
}}

cleanupTests
